  "files": [
    "dist",
    "src"
  ],
  "peerDependencies": {
    "react": "19.2.0",
    "react-native": "0.83.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.14",
    "@upi-spend-tracker/eslint-config": "workspace:*",
    "@upi-spend-tracker/tsconfig": "workspace:*",
    "react": "19.2.0",
    "react-native": "0.83.2"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run src --passWithNoTests",
    "typecheck": "tsc -b --pretty false tsconfig.json"
  }
